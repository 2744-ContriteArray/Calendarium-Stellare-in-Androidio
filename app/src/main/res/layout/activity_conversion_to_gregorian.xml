<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/conversion_background"
    android:orientation="vertical"
    tools:context=".ConversionToGregorian">

    <ImageButton
        android:id="@+id/copyStrdtButton"
        android:layout_width="92dp"
        android:layout_height="45dp"
        android:layout_marginStart="59dp"
        android:layout_marginEnd="130dp"
        android:layout_marginBottom="42dp"
        android:backgroundTint="#00FFFFFF"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/copyGregButton"
        app:srcCompat="@mipmap/copy_lcars" />

    <ImageButton
        android:id="@+id/copyGregButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="36dp"
        android:layout_marginBottom="42dp"
        android:background="#00FFFFFF"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@mipmap/copy_lcars" />

    <ImageButton
        android:id="@+id/con2Greg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="356dp"
        android:layout_marginEnd="112dp"
        android:background="#00FFFFFF"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/greg_lcars" />

    <ImageButton
        android:id="@+id/con2Star"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="60dp"
        android:layout_marginTop="12dp"
        android:background="#00FFFFFF"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/gregInput"
        app:srcCompat="@mipmap/stardate_lcars" />

    <EditText
        android:id="@+id/strdtInput"
        android:layout_width="223dp"
        android:layout_height="71dp"
        android:layout_marginStart="45dp"
        android:layout_marginTop="160dp"
        android:digits="0123456789ABCDEF."
        android:editable="true"
        android:ems="10"
        android:fontFamily="@font/oswald_extralight"
        android:hint="0000000.0000"
        android:inputType="textCapCharacters"
        android:maxLength="12"
        android:singleLine="true"
        android:textAlignment="center"
        android:textAllCaps="true"
        android:textColor="#EB943A"
        android:textColorHint="#91EB943A"
        android:textSize="34sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/gregInput"
        android:layout_width="223dp"
        android:layout_height="71dp"
        android:layout_marginStart="45dp"
        android:layout_marginTop="24dp"
        android:ems="10"
        android:fontFamily="@font/oswald_extralight"
        android:hint="MM/DD/YYYY HH:MM:SS"
        android:inputType="datetime"
        android:maxLength="18"
        android:singleLine="true"
        android:textAlignment="center"
        android:textColor="#EB943A"
        android:textColorHint="#91EB943A"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/strdError" />

    <TextView
        android:id="@+id/strdError"
        android:layout_width="109dp"
        android:layout_height="19dp"
        android:layout_marginStart="120dp"
        android:layout_marginTop="70dp"
        android:layout_marginEnd="183dp"
        android:text="Invalid Stardate!"
        android:textAlignment="center"
        android:textColor="#F80808"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/strdtInput" />

    <TextView
        android:id="@+id/gregError"
        android:layout_width="wrap_content"
        android:layout_height="19dp"
        android:layout_marginStart="107dp"
        android:layout_marginTop="64dp"
        android:layout_marginEnd="169dp"
        android:text="Invalid Calendar date!"
        android:textColor="#F80808"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/gregInput" />

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="56dp"
        android:layout_height="105dp"
        android:layout_marginTop="145dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="481dp"
        android:backgroundTint="#01FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/back_button" />

    <TextView
        android:id="@+id/StarResult"
        android:layout_width="220dp"
        android:layout_height="40dp"
        android:layout_marginStart="45dp"
        android:layout_marginBottom="212dp"
        android:clickable="false"
        android:fontFamily="@font/oswald_extralight"
        android:text="0000000.0000"
        android:textAlignment="center"
        android:textColor="#EB943A"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/resultLbl1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="106dp"
        android:layout_marginBottom="5dp"
        android:fontFamily="@font/oswald_extralight"
        android:text="Stardate"
        android:textColor="#EB943A"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintBottom_toTopOf="@+id/StarResult"
        app:layout_constraintStart_toStartOf="parent" />

    <TextView
        android:id="@+id/gregResult"
        android:layout_width="220dp"
        android:layout_height="40dp"
        android:layout_marginStart="45dp"
        android:layout_marginTop="38dp"
        android:fontFamily="@font/oswald_extralight"
        android:text="08/13/1970 00:00:00"
        android:textAlignment="center"
        android:textColor="#EB943A"
        android:textSize="24sp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/StarResult" />

    <TextView
        android:id="@+id/resultLbl2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="105dp"
        android:layout_marginBottom="6dp"
        android:fontFamily="@font/oswald_extralight"
        android:text="Gregorian Date"
        android:textAlignment="viewStart"
        android:textColor="#EB942A"
        android:textSize="18sp"
        app:layout_constraintBottom_toTopOf="@+id/gregResult"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>