<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@mipmap/conversion_background"
    android:orientation="vertical"
    tools:context=".ConversionToGregorian">

    <ImageButton
        android:id="@+id/copyStrdtButton"
        android:layout_width="92dp"
        android:layout_height="42dp"
        android:layout_marginStart="35dp"
        android:layout_marginTop="61dp"
        android:backgroundTint="#00FFFFFF"
        android:visibility="visible"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/strdtInput"
        app:srcCompat="@mipmap/copy_lcars" />

    <ImageButton
        android:id="@+id/copyGregButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="35dp"
        android:layout_marginBottom="55dp"
        android:background="#00FFFFFF"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@mipmap/copy_lcars" />

    <ImageButton
        android:id="@+id/con2Greg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="65dp"
        android:layout_marginEnd="85dp"
        android:background="#00FFFFFF"
        android:visibility="visible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/strdtInput"
        app:srcCompat="@mipmap/greg_lcars" />

    <ImageButton
        android:id="@+id/con2Star"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="85dp"
        android:layout_marginBottom="55dp"
        android:background="#00FFFFFF"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:srcCompat="@mipmap/stardate_lcars" />

    <EditText
        android:id="@+id/strdtInput"
        android:layout_width="223dp"
        android:layout_height="71dp"
        android:layout_marginStart="58dp"
        android:layout_marginTop="200dp"
        android:layout_marginEnd="130dp"
        android:layout_marginBottom="460dp"
        android:digits="0123456789ABCDEF."
        android:editable="true"
        android:ems="10"
        android:fontFamily="@font/oswald_extralight"
        android:hint="0000000.0000"
        android:inputType="textCapCharacters"
        android:maxLength="12"
        android:singleLine="true"
        android:textAlignment="center"
        android:textAllCaps="true"
        android:textColor="#EB943A"
        android:textColorHint="#91EB943A"
        android:textSize="34sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <EditText
        android:id="@+id/gregInput"
        android:layout_width="223dp"
        android:layout_height="71dp"
        android:layout_marginStart="60dp"
        android:layout_marginTop="480dp"
        android:layout_marginEnd="128dp"
        android:layout_marginBottom="180dp"
        android:ems="10"
        android:fontFamily="@font/oswald_extralight"
        android:hint="MM/DD/YYYY HH:MM:SS"
        android:inputType="datetime"
        android:maxLength="18"
        android:singleLine="true"
        android:textAlignment="center"
        android:textColor="#EB943A"
        android:textColorHint="#91EB943A"
        android:textSize="24sp"
        android:textStyle="bold"
        android:visibility="visible"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0" />

    <TextView
        android:id="@+id/strdError"
        android:layout_width="109dp"
        android:layout_height="19dp"
        android:layout_marginStart="120dp"
        android:layout_marginTop="84dp"
        android:layout_marginEnd="183dp"
        android:text="Invalid Stardate!"
        android:textAlignment="center"
        android:textColor="#F80808"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/strdtInput" />

    <TextView
        android:id="@+id/gregError"
        android:layout_width="wrap_content"
        android:layout_height="19dp"
        android:layout_marginStart="107dp"
        android:layout_marginEnd="169dp"
        android:layout_marginBottom="12dp"
        android:text="Invalid Calendar date!"
        android:textColor="#F80808"
        app:layout_constraintBottom_toTopOf="@+id/gregInput"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageButton
        android:id="@+id/backButton"
        android:layout_width="56dp"
        android:layout_height="105dp"
        android:layout_marginTop="145dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="481dp"
        android:backgroundTint="#01FFFFFF"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@mipmap/back_button" />

</androidx.constraintlayout.widget.ConstraintLayout>